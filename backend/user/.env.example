# User Service — Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# Server port for the user microservice
PORT=8000

# JWT secret key — use a long, random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# Redis connection URL (Upstash or local Redis instance)
REDIS_URL=redis://localhost:6379

# RabbitMQ broker connection details
Rabbitmq_Host=localhost
Rabbitmq_Username=guest
Rabbitmq_Password=guest
