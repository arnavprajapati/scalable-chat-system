# Chat Service — Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB connection string (same cluster, same database as user-service)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# Server port for the chat microservice (also used by Socket.IO)
PORT=8002

# JWT secret — must be identical to user-service JWT_SECRET for token verification
JWT_SECRET=your_super_secret_jwt_key_here

# Internal URL of the user-service for inter-service HTTP calls (profile resolution)
USER_SERVICE=http://localhost:8000

# Cloudinary credentials for image upload pipeline
Cloud_Name=your_cloudinary_cloud_name
Api_Key=your_cloudinary_api_key
Api_Secret=your_cloudinary_api_secret
