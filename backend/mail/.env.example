# Mail Service — Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server port for the mail microservice
PORT=8001

# RabbitMQ broker connection details (must match user-service config)
Rabbitmq_Host=localhost
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Gmail SMTP credentials for Nodemailer
# Enable "App Passwords" in your Google account for secure access
USER=your_gmail_address@gmail.com
PASSWORD=your_gmail_app_password
